{
  "name": "@lapismd/jj-acp",
  "version": "0.1.0",
  "private": true,
  "description": "Pluggable Agent Client Protocol harness for controlling applications",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "cargo build --workspace --locked",
    "check": "pnpm spec:validate && pnpm release:check && pnpm check:boundaries && pnpm check:architecture && pnpm check:progress && pnpm upstream:self-test && pnpm format:check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:architecture": "node scripts/rust-architecture.mjs",
    "check:progress": "node scripts/check-progress.mjs",
    "test": "pnpm test:governance && cargo test --workspace --locked",
    "test:governance": "node --test scripts/governance.test.mjs scripts/rust-architecture.test.mjs scripts/upstream-lock.test.mjs scripts/progress-vcs.test.mjs scripts/release.test.mjs scripts/registry-check.test.mjs scripts/changesets.test.mjs scripts/release-orchestration.test.mjs scripts/ci-automation.test.mjs",
    "upstream:self-test": "node scripts/upstream-sync.mjs --self-test",
    "upstream:write": "node scripts/upstream-sync.mjs --write",
    "upstream:fetch": "node scripts/upstream-sync.mjs --fetch",
    "format": "cargo fmt --all && prettier --write .",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all -- --check",
    "format:check": "pnpm format:rust:check && prettier --check .",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:validate": "spec-validator validate",
    "check:workflow": "actionlint",
    "package:check": "node scripts/package-check.mjs",
    "release:dry-run": "pnpm package:check && cargo publish --workspace --locked --dry-run",
    "changeset": "changeset",
    "release:status": "node scripts/release-state.mjs --plan",
    "release:plan": "node scripts/release-state.mjs --plan",
    "release:check": "node scripts/release-state.mjs",
    "release:version": "node scripts/changeset-version.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@changesets/read": "^0.6.7",
    "@iarna/toml": "^2.2.5",
    "@lapismd/spec-validator": "^0.1.0",
    "prettier": "^3.9.10"
  }
}
